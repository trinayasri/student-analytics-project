# ==============================================================================
# AI-Powered Student Performance Analytics Platform - Environment Configuration
# ==============================================================================

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./student_analytics.db
# For PostgreSQL in production, uncomment and update:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/student_analytics

# Security & Authentication (JWT)
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini AI Integration
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Frontend Dashboard Configuration
BACKEND_API_URL=http://127.0.0.1:8000
STREAMLIT_PORT=8501
